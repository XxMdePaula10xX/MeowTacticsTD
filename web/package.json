{
  "name": "meow-tactics-td",
  "version": "0.1.0",
  "description": "Meow Tactics TD — tower defense com sinergias (Canvas/JS), empacotável para iOS via Capacitor.",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 8080",
    "build": "python3 build.py",
    "www": "rm -rf www && mkdir www && cp -R index.html src styles assets www/",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:assets": "npx @capacitor/assets generate --assetPath resources --ios --iconBackgroundColor '#0f1020' --splashBackgroundColor '#0f1020'"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2"
  }
}
